# =============================================================================
# API-Honeypot-System — root .gitignore
# =============================================================================

# ---- Secrets & local config -------------------------------------------------
.env
.env.local
.env.*.local
!.env.example
!config/.env.example
honey_pot/.env
honey_pot/config/.env

# ---- Model binaries & ML artifacts ------------------------------------------
*.onnx
*.pkl
*.joblib
*.h5
*.hdf5
*.ckpt
*.pt
*.pth
*.pb
*.tflite
*.npy
*.npz
*.safetensors

# ---- Databases & runtime logs -----------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
logs/
**/logs/
honey_pot/logs/

# ---- Compiled binaries ------------------------------------------------------
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.obj
*.o
*.pdb
*.exp
*.ilk
*.idb
*.out
honeypot
honeypot.exe
ml_service_cpp
ml_service_cpp.exe

# ---- Build / package manager artifacts --------------------------------------
build/
**/build/
bin/
**/bin/
out/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
vcpkg_installed/
**/vcpkg_installed/
.vcpkg-root

# ---- Go --------------------------------------------------------------------
honey_pot/vendor/
*.test
*.prof

# ---- Visual Studio / IDEs ---------------------------------------------------
.vs/
.vscode/
!.vscode/extensions.json
*.vcxproj*
*.sln
*.user
*.filters
.idea/
*.swp
*.swo
*~

# ---- Python (model export helpers) ------------------------------------------
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# ---- Docker / OS ------------------------------------------------------------
*.tmp
*.temp
*.cache
.DS_Store
Thumbs.db
desktop.ini

# ---- Model directory contents (keep folder via .gitkeep) --------------------
ml-service/models/*
!ml-service/models/.gitkeep
