# =============================================================================
# API Honeypot — environment template
# Copy to honey_pot/.env or repo-root .env and adjust as needed.
# =============================================================================

# Go honeypot bind address
HONEYPOT_HOST=0.0.0.0
HONEYPOT_PORT=8080
# Or set full address: HONEYPOT_ADDR=0.0.0.0:8080

# C++ ONNX inference endpoint
ML_SERVICE_URL=http://localhost:5000/predict

# Logging paths
LOG_DB_PATH=./logs/honeypot.db
LOG_JSON_PATH=./logs/requests.json

# Timeouts & deception latency (milliseconds)
REQUEST_TIMEOUT_MS=5000
MIN_DELAY_MS=100
MAX_DELAY_MS=800
ATTACK_DELAY_MS=2000

# Safe defaults when ML service is unreachable / times out
FALLBACK_LABEL=normal
FALLBACK_CONFIDENCE=0.5

# C++ ML service (used by ml-service binary / Docker)
ML_SERVICE_PORT=5000
ONNX_MODEL_PATH=./models/random_forest.onnx
